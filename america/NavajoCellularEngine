def generate_layered_armor(self, rule_top: int, rule_mid: int, rule_bottom: int) -> np.ndarray:
    """
    Реализует инсайт ICSR: генерирует трехсоставную нарративную одежду.
    Вычисляет каждый ярус полотна по своему правилу Вольфрама.
    """
    # Делим высоту ковра/плаща на 3 равные зоны
    tier_height = self.height // 3
    
    # 1. Ткем НИЖНИЙ ЯРУС (Ремесло)
    rule_map_bottom = self._get_wolfram_rule_map(rule_bottom)
    # Задаем стартовый хаотичный или упорядоченный ряд для низа
    self.grid[0, :] = np.random.randint(0, 2, self.width)
    
    for r in range(1, tier_height):
        for c in range(self.width):
            left = self.grid[r-1, (c - 1) % self.width]
            center = self.grid[r-1, c]
            right = self.grid[r-1, (c + 1) % self.width]
            self.grid[r, c] = rule_map_bottom[(left, center, right)]
            
    # 2. Ткем СРЕДНИЙ ЯРУС (Город)
    rule_map_mid = self._get_wolfram_rule_map(rule_mid)
    # Переходный ряд: берем последний ряд нижнего яруса как фундамент для среднего!
    for r in range(tier_height, 2 * tier_height):
        for c in range(self.width):
            left = self.grid[r-1, (c - 1) % self.width]
            center = self.grid[r-1, c]
            right = self.grid[r-1, (c + 1) % self.width]
            self.grid[r, c] = rule_map_mid[(left, center, right)]
            
    # 3. Ткем ВЕРХНИЙ ЯРУС (Страна)
    rule_map_top = self._get_wolfram_rule_map(rule_top)
    # Переходный ряд: берем базу от среднего яруса
    for r in range(2 * tier_height, self.height):
        for c in range(self.width):
            left = self.grid[r-1, (c - 1) % self.width]
            center = self.grid[r-1, c]
            right = self.grid[r-1, (c + 1) % self.width]
            self.grid[r, c] = rule_map_top[(left, center, right)]
            
    return self.grid
